{
  "name": "dsh-client-ui-trajectory-plus",
  "version": "0.1.3",
  "description": "Third conversation view for DeepSeek Harness: one card per turn, including the turns the platform trajectory draws no row for. Read-only by construction; delete and re-run are proxied to dsh-delete-turn and dsh-rerun-turn and only appear when those plugins are mounted.",
  "type": "module",
  "main": "src/index.js",
  "exports": { ".": "./src/index.js", "./client": "./src/client.js", "./logic": "./src/logic.js", "./package.json": "./package.json" },
  "files": ["src", "cordis.patch.yml", "README.md", "LICENSE"],
  "keywords": ["deepseek-harness", "dsh", "dsh-plugin", "trajectory", "surface", "turn", "conversation-view"],
  "license": "MIT",
  "engines": { "node": ">=22" },
  "scripts": { "test": "node --test test/*.test.js" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-ui-renderer", "@deepseek-ai/dsh-client-ui-conversation"]
    },
    "engines": { "dsh": ">=0.1.6-alpha.2" }
  }
}
